NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
DB_PATH=./data/hotelzz.db
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
COOKIE_NAME=hz_session

# SMTP (leave blank in dev — emails print to the server console instead).
# Hotelzz sends from 3 mailboxes on one host: info@ (traveller/marketing mail),
# support@ (partner mail), admin@ (internal ops alerts). Each SMTP_USER_*/
# SMTP_PASS_* pair below falls back to the plain SMTP_USER/SMTP_PASS (the
# "info" mailbox) when left blank, so a single mailbox still works.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false

SMTP_USER_INFO=
SMTP_PASS_INFO=
MAIL_FROM_INFO=Hotelzz <info@hotelzz.in>

SMTP_USER_SUPPORT=
SMTP_PASS_SUPPORT=
MAIL_FROM_SUPPORT=Hotelzz Partner Support <support@hotelzz.in>

SMTP_USER_ADMIN=
SMTP_PASS_ADMIN=
MAIL_FROM_ADMIN=Hotelzz Ops <admin@hotelzz.in>

# Legacy single-mailbox fallback
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Hotelzz <no-reply@hotelzz.in>
ADMIN_EMAIL=admin@hotelzz.in

# "Sign in with Google" (traveler/owner). Leave blank to hide the button.
# Register in Google Cloud Console -> Credentials -> OAuth client (Web app):
#   Origins:   http://localhost:3000, https://hotelzz.in
#   Redirects: http://localhost:3000/api/auth/google/callback
#              https://hotelzz.in/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Seed admin
SEED_ADMIN_EMAIL=admin@hotelzz.in
SEED_ADMIN_PASSWORD=admin123

OTP_TTL_MIN=10
OTP_DEV_ECHO=true

# Uploads
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_MB=8

# Payments (Razorpay). Leave blank to keep manual invoicing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CURRENCY=INR

# Ad platforms. Leave blank to fulfil campaigns manually.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_ACCESS_TOKEN=

# Google Sheet mirror. Apps Script Web App URL (from LEADS-APPS-SCRIPT.gs,
# action=logUpdate) — every admin action gets appended as a row there too.
# Leave blank to skip. See SETUP-GOOGLE-SHEET.md Part 3.
GOOGLE_SHEET_WEBHOOK_URL=
